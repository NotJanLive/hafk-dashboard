# Copy to .env.local for local development. Never commit real values.

# Public URL of the dashboard (also used for the OAuth redirect: <APP_URL>/api/auth/callback/discord)
APP_URL=http://localhost:3000

# Encrypts the session cookie, at least 32 characters (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Discord Developer Portal -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Internal bot API, must match API_HOST/API_PORT/API_TOKEN of the bot
BOT_API_URL=http://127.0.0.1:8081
BOT_API_TOKEN=

# Permission integer for the bot invite link
BOT_INVITE_PERMISSIONS=268823632
