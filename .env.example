# Copy to .env.local for local development. Never commit real values.

# Public URL of the dashboard (also used for the OAuth redirect: <DASHBOARD_URL>/api/auth/callback/discord)
DASHBOARD_URL=http://localhost:3000

# Discord Developer Portal -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Address of the bot API, built from BOT_API_HOST and BOT_API_PORT in the bot's .env
BOT_API_URL=http://127.0.0.1:8081

# Same value as SHARED_SECRET in the bot's .env (not the Discord bot token), at least 32 characters
SHARED_SECRET=

# Dashboard only: encrypts the login cookies. Must differ from SHARED_SECRET, at least 32 characters
SESSION_SECRET=

# Permission integer for the bot invite link
BOT_INVITE_PERMISSIONS=268823632
